# ========================================
# InsightFlow AI — Environment Configuration
# ========================================
# Copy this file to .env and fill in values
# NEVER commit the .env file

# --- Database ---
DATABASE_URL=postgresql+asyncpg://insightflow:insightflow_pass@localhost:5432/insightflow

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Pinecone ---
# Get from https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=insightflow-index
PINECONE_ENVIRONMENT=us-east-1-aws

# --- LLM Provider ---
# Options: openai, gemini
LLM_PROVIDER=gemini

# --- OpenAI ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini ---
# Get from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001

# --- LangSmith (Optional) ---
# Get from https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=insightflow-ai

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Application & Environment ---
ENVIRONMENT=development
DEBUG=false
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=20
TOP_K_RERANK=6
RERANKER_TYPE=lightweight
CACHE_TTL_SECONDS=3600
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=https://your-app.vercel.app

# --- Frontend (configured in Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
