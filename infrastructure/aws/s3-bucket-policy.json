{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowECSBackendUploads",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskRole"
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::insightflow-uploads-${AWS_REGION}-${AWS_ACCOUNT_ID}",
        "arn:aws:s3:::insightflow-uploads-${AWS_REGION}-${AWS_ACCOUNT_ID}/*"
      ]
    }
  ]
}
